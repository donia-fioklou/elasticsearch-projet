# ─────────────────────────────────────────────
# Copier ce fichier en .env et remplir les valeurs
#   cp .env.example .env
# ─────────────────────────────────────────────

# Clé API TMDB (obligatoire pour fetch_tmdb.py)
# Obtiens la tienne sur : https://www.themoviedb.org/settings/api
TMDB_API_KEY=colle_ta_cle_ici

# URL Elasticsearch (ne pas modifier si tu utilises docker-compose)
ES_URL=http://elasticsearch:9200
